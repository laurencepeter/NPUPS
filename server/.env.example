# =============================================================================
# WorkForce API — runtime environment (server-side secrets)
# =============================================================================
# Copy to `.env` for local runs (`.env` is gitignored). In Coolify these are
# set as environment variables on the `api` service. NEVER commit real values.

# Supabase project the API reads/writes through (the API is the only process
# that touches the database).
SUPABASE_URL=https://supabase.example.com
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace_me

PORT=8080

# ── Authentication ──────────────────────────────────────────────────────────
# production | development. In production the API refuses to start without a
# JWT secret (fail-secure).
NODE_ENV=production

# HS256 signing secret for API session tokens. REQUIRED in production; min 32
# chars. Generate with: openssl rand -base64 48
# Keep it stable — rotating it invalidates every issued token (forces re-login).
API_JWT_SECRET=replace_me_with_at_least_32_random_characters

# Session token lifetime (any `jsonwebtoken` duration, e.g. 8h, 12h, 1d).
JWT_EXPIRES_IN=8h

# Comma-separated cross-origin allowlist. Leave EMPTY for the same-origin nginx
# proxy (recommended) — empty disables CORS so browsers block cross-origin use.
CORS_ALLOWED_ORIGINS=

# Escape hatch to run WITHOUT auth (all routes open). Only honored outside
# production, and only for local demo / CI. NEVER set this in production.
# ALLOW_INSECURE_NO_AUTH=true
