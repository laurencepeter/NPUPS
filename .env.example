# =============================================================================
# NPUPS — Flutter build-time configuration template
# =============================================================================
# Copy this file to `.env` and fill in your Coolify Supabase values.
# `.env` is gitignored — never commit real values.
#
# Local web build:
#   flutter build web --release --dart-define-from-file=.env
#
# Local run (Chrome):
#   flutter run -d chrome --dart-define-from-file=.env
#
# In Coolify these are set as build environment variables and forwarded to the
# Docker build via ARGs — see Dockerfile and SUPABASE_SETUP.md.
# =============================================================================

# Your self-hosted Supabase API gateway (Kong) URL.
SUPABASE_URL=https://supabase.example.com

# The Supabase project ANON / PUBLIC key.
# This is intentionally public — RLS enforces tenant isolation.
# NEVER put the service_role key here.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace_me
