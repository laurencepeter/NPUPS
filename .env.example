# ══════════════════════════════════════════════════════════════════════════════
# NPUPS Environment Variables
# Copy to .env and fill in real values before running docker-compose.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=npups
POSTGRES_USER=npups_admin

# Strong password for the Postgres superuser
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── JWT ────────────────────────────────────────────────────────────────────
# Shared secret between PostgreSQL (signs tokens) and PostgREST (validates them).
# Generate with: openssl rand -hex 32
NPUPS_JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── PostgREST ──────────────────────────────────────────────────────────────
# Password for the 'authenticator' PostgreSQL role used by PostgREST
POSTGREST_DB_PASSWORD=CHANGE_ME_postgrest_role_password

# ── Flutter Web App ────────────────────────────────────────────────────────
# The URL that users' browsers use to reach the PostgREST API.
# On VPN this is the server's internal IP or hostname.
# Example: http://192.168.10.5:3000  or  https://api.npups.internal
API_BASE_URL=http://YOUR_SERVER_IP:3000
